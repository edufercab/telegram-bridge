# Generate a secure key: openssl rand -hex 32
API_KEY=

# From BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (see setup guide in README)
TELEGRAM_CHAT_ID=

# Server port (default: 3001)
PORT=3001

# Minutes of inactivity before session auto-expires (default: 30)
SESSION_TIMEOUT_MINUTES=30

# development | production
NODE_ENV=development

# Bot response language: en | es | zh | hi | ar | fr
LANGUAGE=en
