{
  "name": "telegram-bridge",
  "version": "0.1.0",
  "description": "Bidirectional Telegram bridge for Claude Code — Claude controls the session, not the other way around",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc --project tsconfig.sdk.json",
    "start": "node dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.sdk.json"
  },
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "bridge",
    "ai",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.12.23",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
